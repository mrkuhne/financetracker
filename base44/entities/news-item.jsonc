{
  "name": "NewsItem",
  "type": "object",
  "properties": {
    "owner_id": { "type": "string" },
    "source_id": { "type": "string" },
    "source_name": { "type": "string" },
    "title": { "type": "string" },
    "link": { "type": "string" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "title_hu": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "affects_portfolio": { "type": "boolean" },
    "ai_done": { "type": "boolean" },
    "analysis": { "type": ["object", "null"] }
  },
  "required": ["owner_id", "source_id", "title", "link"],
  "rls": { "create": false, "read": { "data.owner_id": "{{user.id}}" }, "update": false, "delete": false }
}
