{
  "name": "User",
  "type": "object",
  "properties": {
    "base_currency": {
      "type": "string",
      "enum": [
        "HUF"
      ],
      "default": "HUF"
    },
    "monthly_savings_target_minor": {
      "type": "integer"
    },
    "monthly_investment_amount_minor": {
      "type": [
        "integer",
        "null"
      ]
    },
    "emergency_fund_months": {
      "type": "number"
    },
    "week_start": {
      "type": "string",
      "enum": [
        "monday"
      ],
      "default": "monday"
    },
    "digest_time": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "month_overrides": {
      "type": "object"
    },
    "invest_suggested_log": {
      "type": "object"
    },
    "brief_snapshot": {
      "type": ["object", "null"]
    },
    "has_expensive_debt": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "guide_cache": {
      "type": [
        "object",
        "null"
      ]
    },
    "risk_profile": {
      "type": "string",
      "enum": ["cautious", "balanced", "bold"]
    },
    "risk_checkin_at": {
      "type": ["string", "null"],
      "format": "date"
    },
    "digest_enabled": {
      "type": "boolean"
    },
    "news_interval_hours": {
      "type": "integer",
      "enum": [2, 4, 8, 12]
    },
    "invest_cache": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}