{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "key_hash": { "type": "string" },
    "last4": { "type": "string" },
    "owner_id": { "type": "string" },
    "revoked": { "type": "boolean" },
    "last_used_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["name", "key_hash", "last4", "owner_id"],
  "rls": { "create": true, "read": {"created_by_id": "{{user.id}}"}, "update": {"created_by_id": "{{user.id}}"}, "delete": {"created_by_id": "{{user.id}}"} }
}
