{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "expense",
        "income",
        "transfer_out",
        "transfer_in"
      ]
    },
    "amount_minor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "amount_huf_minor": {
      "type": "integer"
    },
    "category_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "sms",
        "recurring"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "recurring_rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transfer_pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sms_message_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "account_id",
    "kind",
    "amount_minor",
    "currency",
    "amount_huf_minor",
    "date",
    "source"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}