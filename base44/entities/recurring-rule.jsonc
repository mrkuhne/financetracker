{
  "name": "RecurringRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ]
    },
    "amount_minor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "amount_huf_minor": {
      "type": "integer"
    },
    "category_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "account_id": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "yearly"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "last_materialized_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "kind",
    "amount_minor",
    "currency",
    "amount_huf_minor",
    "account_id",
    "frequency",
    "start_date"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}